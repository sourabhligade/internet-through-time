    "sites/yahoo/whats-cool.html": "http://akebono.stanford.edu/yahoo/cool.html",
    "sites/yahoo/whats-popular.html": "http://akebono.stanford.edu/yahoo/popular.html",
    "sites/yahoo/random.html": "http://akebono.stanford.edu/yahoo/random.html",
    "sites/yahoo/about-yahoo.html": "http://akebono.stanford.edu/yahoo/about.html",
    "sites/yahoo/search.html": "http://akebono.stanford.edu/yahoo/search.html",
    "sites/yahoo/add.html": "http://akebono.stanford.edu/yahoo/add.html",
    "sites/personal/index.html": "http://www.university.edu/~jdoe/",
    "sites/personal/messy.html": "http://www.cs.podunk.edu/~skater/home.html",
    "sites/whitehouse/index.html": "http://www.whitehouse.gov/",
    "sites/nasa/index.html": "http://www.nasa.gov/",
    "sites/iuma/index.html": "http://www.iuma.com/",
    "sites/ncsa/index.html": "http://www.ncsa.uiuc.edu/",
    "sites/ncsa/mosaic.html": "http://www.ncsa.uiuc.edu/SDG/Software/Mosaic/",
    "sites/ncsa/whats-new.html": "http://www.ncsa.uiuc.edu/SDG/Software/Mosaic/Docs/whats-new.html",
    "sites/fishcam/index.html": "http://home.mcom.com/fishcam/",
    "sites/csotd/index.html": "http://cool.infi.net/",
    "sites/cern/index.html": "http://info.cern.ch/",
    "sites/mcom/index.html": "http://home.mcom.com/",
    "sites/lycos/index.html": "http://lycos.cs.cmu.edu/",
    "sites/hotwired/index.html": "http://www.hotwired.com/",
    "sites/hotwired/signal.html": "http://www.hotwired.com/signal/",
    "sites/hotwired/agent.html": "http://www.hotwired.com/agent/",
    "sites/hotwired/coin.html": "http://www.hotwired.com/coin/",
    "sites/hotwired/renaissance.html": "http://www.hotwired.com/renaissance/",
    "sites/hotwired/ad-att.html": "http://www.hotwired.com/sponsors/att/"
  };

  var TITLE_MAP = {
    "pages/home.html": "Welcome to the World Wide Web — Netscape",
    "pages/about.html": "About This Exhibit — 1994",
    "pages/cool.html": "What's Cool! — Netscape",
    "pages/whats-new.html": "What's New! — Netscape",
    "pages/handbook.html": "Netscape Handbook",
    "pages/error/404.html": "Not Found",
    "pages/error/unreachable.html": "Unable to Locate Server",
    "sites/yahoo/index.html": "Yahoo!",
    "sites/personal/index.html": "John's Home Page",
    "sites/personal/messy.html": "SKATER's Home Page!!!!!",
    "sites/whitehouse/index.html": "Welcome To The White House",
    "sites/nasa/index.html": "NASA Home Page",
    "sites/iuma/index.html": "IUMA — Internet Underground Music Archive",
    "sites/ncsa/index.html": "NCSA — National Center for Supercomputing Applications",
    "sites/ncsa/mosaic.html": "NCSA Mosaic",
    "sites/ncsa/whats-new.html": "What's New With NCSA Mosaic",
    "sites/fishcam/index.html": "Fish Cam",
    "sites/csotd/index.html": "Cool Site of the Day",
    "sites/cern/index.html": "World Wide Web — CERN",
    "sites/mcom/index.html": "Welcome to Netscape",
    "sites/lycos/index.html": "Lycos Catalog of the Internet",
    "sites/hotwired/index.html": "HotWired",
    "sites/hotwired/signal.html": "HotWired — Signal",
    "sites/hotwired/agent.html": "HotWired — Intelligent Agent",
    "sites/hotwired/coin.html": "HotWired — Coin",
    "sites/hotwired/renaissance.html": "HotWired — Renaissance",
    "sites/hotwired/ad-att.html": "AT&T — You Will"
  };

  var DEFAULT_BOOKMARKS = [
    { title: "Starting Point", path: "pages/home.html" },
    { title: "Welcome to Netscape", path: "sites/mcom/index.html" },
    { title: "Yahoo!", path: "sites/yahoo/index.html" },
    { title: "Lycos", path: "sites/lycos/index.html" },
    { title: "NCSA Mosaic", path: "sites/ncsa/mosaic.html" },
    { title: "The White House", path: "sites/whitehouse/index.html" },
    { title: "NASA", path: "sites/nasa/index.html" },
    { title: "IUMA", path: "sites/iuma/index.html" },
    { title: "Fish Cam", path: "sites/fishcam/index.html" },
    { title: "Cool Site of the Day", path: "sites/csotd/index.html" },
    { title: "What's Cool!", path: "pages/cool.html" },
    { title: "Netscape Handbook", path: "pages/handbook.html" }
  ];

  /* ---------- state ---------- */
  var historyStack = [];
  var historyIndex = -1;
  var imagesOn = true;
  var loading = false;
  var loadTimer = null;
  var loadGen = 0;
  var statusTimers = [];
  var imageRevealTimers = [];
  var loadStartedAt = 0;
  var findLastQuery = "";
  var findLastIndex = 0;
  var clipboardText = "";
  var maximized = false;
  var lastAttemptedUrl = "";
  var ignoreIframeLoad = false;

  var prefs = loadPrefs();
  var bookmarks = loadBookmarks();

  /* ---------- DOM ---------- */
  var iframe = document.getElementById("content");
  var locationInput = document.getElementById("location");
  var statusEl = document.getElementById("status");
  var statusDone = document.getElementById("status-done");
  var windowTitle = document.getElementById("window-title");
  var throbber = document.getElementById("throbber");
  var btnBack = document.getElementById("btn-back");
  var btnForward = document.getElementById("btn-forward");
  var browserEl = document.getElementById("browser");
  var menubar = document.getElementById("menubar");
  var backdrop = document.getElementById("modal-backdrop");
  var taskIcon = document.getElementById("task-icon");

  /* ============================================================
   * Prefs / bookmarks storage
   * ============================================================ */
  function loadPrefs() {
    try {
      var raw = localStorage.getItem(PREFS_KEY);
      if (raw) return Object.assign(defaultPrefs(), JSON.parse(raw));
    } catch (e) { /* */ }
    return defaultPrefs();
  }
  function defaultPrefs() {
    return {
      underline: true,
      expireDays: 30,
      autoload: true,
      modemDelay: 350,
      homeUrl: "http://home.nerf.edu/web1994/",
      homePath: HOME,
      showToolbar: true,
      showLocation: true,
      showDirbar: true,
      showDesktopIcons: true,
      desktopBg: "#000000"
    };
  }
  function savePrefs() {
    try { localStorage.setItem(PREFS_KEY, JSON.stringify(prefs)); } catch (e) { /* */ }
    applyChromePrefs();
  }
  function loadBookmarks() {
    try {
      var raw = localStorage.getItem(BM_KEY);
      if (raw) return JSON.parse(raw);
    } catch (e) { /* */ }
    return DEFAULT_BOOKMARKS.slice();
  }
  function saveBookmarks() {
    try { localStorage.setItem(BM_KEY, JSON.stringify(bookmarks)); } catch (e) { /* */ }
    renderBookmarkMenus();
  }

  function applyChromePrefs() {
    imagesOn = !!prefs.autoload;
    browserEl.classList.toggle("toolbar-hidden", !prefs.showToolbar);
    browserEl.classList.toggle("location-hidden", !prefs.showLocation);
    browserEl.classList.toggle("dirbar-hidden", !prefs.showDirbar);
    var t = document.getElementById("opt-toolbar-item");
    var l = document.getElementById("opt-location-item");
    var d = document.getElementById("opt-dirbar-item");
    var a = document.getElementById("opt-autoload-item");
    if (t) t.textContent = (prefs.showToolbar ? "✓ " : "   ") + "Show Toolbar";
    if (l) l.textContent = (prefs.showLocation ? "✓ " : "   ") + "Show Location";
    if (d) d.textContent = (prefs.showDirbar ? "✓ " : "   ") + "Show Directory Buttons";
    if (a) a.textContent = (prefs.autoload ? "✓ " : "   ") + "Auto Load Images";

    var desk = document.querySelector(".desktop");
    var bg = prefs.desktopBg || "#000000";
    document.documentElement.style.setProperty("--desktop-bg", bg);
    if (desk) desk.style.background = bg;
    document.body.style.background = bg;

    var icons = document.getElementById("desktop-icons");
    if (icons) {
      if (prefs.showDesktopIcons === false) icons.classList.add("hidden");
      else icons.classList.remove("hidden");
    }
  }

  /* ============================================================
   * Path / URL helpers
   * ============================================================ */
  function normalizePath(path) {
    if (!path) return HOME;
    path = String(path).replace(/^\.\//, "");
    try {
      if (path.indexOf("http") === 0) {
        var u = new URL(path);
        path = u.pathname + u.search;
      }
    } catch (e) { /* */ }
    var marker = "/years/1994/";
    var i = path.indexOf(marker);
    if (i !== -1) path = path.slice(i + marker.length);
    if (path.charAt(0) === "/") {
      var j = path.indexOf("years/1994/");
      if (j !== -1) path = path.slice(j + "years/1994/".length);
      else path = path.replace(/^\//, "");
    }
    return path;
  }

  function pathFromIframe() {
    try {
      var loc = iframe.contentWindow.location;
      var path = loc.pathname;
      var marker = "/years/1994/";
      var i = path.indexOf(marker);
      if (i !== -1) {
        var p = path.slice(i + marker.length);
        if (loc.search) p += loc.search;
        return p;
      }
      return normalizePath(iframe.getAttribute("src") || HOME);
    } catch (e) {
      return normalizePath(iframe.getAttribute("src") || HOME);
    }
  }

  function resolveHref(href, currentPath) {
    if (!href) return null;
    if (href.charAt(0) === "#") return null;
    if (href.indexOf("mailto:") === 0) return null;
    if (href.indexOf("http://") === 0 || href.indexOf("https://") === 0) {
      return { external: true, href: href };
    }
    var pathOnly = currentPath.split("?")[0];
    var baseDir = pathOnly.replace(/\/[^/]*$/, "/");
    if (pathOnly.indexOf("/") === -1) baseDir = "";
    var combined = href.charAt(0) === "/" ? href.replace(/^\//, "") : baseDir + href;
    var segs = combined.split("/");
    var out = [];
    for (var s = 0; s < segs.length; s++) {
      if (segs[s] === "" || segs[s] === ".") continue;
      if (segs[s] === "..") out.pop();
      else out.push(segs[s]);
    }
    return { external: false, path: out.join("/") };
  }

  function displayUrl(path) {
    var clean = normalizePath(path).split("?")[0];
    if (URL_MAP[clean]) return URL_MAP[clean];
    if (clean.indexOf("sites/yahoo/") === 0)
      return "http://akebono.stanford.edu/yahoo/" + clean.replace("sites/yahoo/", "").replace(/\/index\.html$/, "/");
    if (clean.indexOf("sites/whitehouse/") === 0)
      return "http://www.whitehouse.gov/" + clean.replace("sites/whitehouse/", "");
    if (clean.indexOf("sites/nasa/") === 0)
      return "http://www.nasa.gov/" + clean.replace("sites/nasa/", "");
    if (clean.indexOf("sites/ncsa/") === 0)
      return "http://www.ncsa.uiuc.edu/" + clean.replace("sites/ncsa/", "");
    if (clean.indexOf("sites/iuma/") === 0)
      return "http://www.iuma.com/" + clean.replace("sites/iuma/", "");
    if (clean.indexOf("sites/personal/") === 0) {
      if (clean.indexOf("messy") !== -1)
        return "http://www.cs.podunk.edu/~skater/" + clean.replace("sites/personal/", "").replace("messy.html", "home.html");
      return "http://www.university.edu/~jdoe/" + clean.replace("sites/personal/", "").replace("index.html", "");
    }
    if (clean.indexOf("sites/fishcam/") === 0)
      return "http://home.mcom.com/fishcam/" + clean.replace("sites/fishcam/", "").replace("index.html", "");
    if (clean.indexOf("sites/csotd/") === 0)
      return "http://cool.infi.net/" + clean.replace("sites/csotd/", "").replace("index.html", "");
    if (clean.indexOf("sites/cern/") === 0)
      return "http://info.cern.ch/" + clean.replace("sites/cern/", "").replace("index.html", "");
    if (clean.indexOf("sites/mcom/") === 0)
      return "http://home.mcom.com/" + clean.replace("sites/mcom/", "").replace("index.html", "");
    if (clean.indexOf("sites/lycos/") === 0)
      return "http://lycos.cs.cmu.edu/" + clean.replace("sites/lycos/", "").replace("index.html", "");
    if (clean.indexOf("sites/hotwired/") === 0)
      return "http://www.hotwired.com/" + clean.replace("sites/hotwired/", "").replace("index.html", "");
    if (clean.indexOf("pages/handbook/") === 0)
      return "http://home.mcom.com/home/manual_docs/" + clean.replace("pages/handbook/", "");
    return "http://home.nerf.edu/web1994/" + clean;
  }

  function hostFromDisplayUrl(url) {
    try {
      return new URL(url).hostname;
    } catch (e) {
      var m = String(url).match(/https?:\/\/([^\/]+)/i);
      return m ? m[1] : "unknown.host";
    }
  }

  function brokenImageUrl() {
    try {
      return new URL("../../assets/gif/broken.gif", window.location.href).href;
    } catch (e) {
      return "../../assets/gif/broken.gif";
    }
  }

  function clearLoadTimers() {
    if (loadTimer) {
      clearTimeout(loadTimer);
      loadTimer = null;
    }
    var i;
    for (i = 0; i < statusTimers.length; i++) clearTimeout(statusTimers[i]);
    statusTimers = [];
    for (i = 0; i < imageRevealTimers.length; i++) clearTimeout(imageRevealTimers[i]);
    imageRevealTimers = [];
  }

  function displayTitle(path) {
    var clean = normalizePath(path).split("?")[0];
    if (TITLE_MAP[clean]) return TITLE_MAP[clean] + " - Netscape";
    var parts = clean.split("/");
    var last = parts[parts.length - 1].replace(".html", "").replace(/_/g, " ");
    if (last === "index" && parts.length > 1) last = parts[parts.length - 2].replace(/_/g, " ");
    if (clean.indexOf("sites/yahoo/") === 0) return "Yahoo! - " + last + " - Netscape";
    return last.charAt(0).toUpperCase() + last.slice(1) + " - Netscape";
  }

  function currentPath() {
    return historyIndex >= 0 ? historyStack[historyIndex] : HOME;
  }

  /* ============================================================
   * Status / loading
   * ============================================================ */
  function setStatus(text) {
    statusEl.textContent = text;
  }
  function setLoading(on) {
    loading = on;
    if (on) {
      throbber.classList.remove("idle");
      statusDone.textContent = "";
      browserEl.classList.add("loading");
      setStatus("Transferring data from host...");
    } else {
      throbber.classList.add("idle");
      browserEl.classList.remove("loading");
      statusDone.textContent = "Document: Done";
      setStatus("Document: Done");
    }
  }
  function finishDocumentLoad(imgCount) {
    loading = false;
    throbber.classList.add("idle");
    browserEl.classList.remove("loading");
    var elapsed = Math.max(1, Math.round((Date.now() - loadStartedAt) / 1000) || 1);
    statusDone.textContent = "Document: Done";
    var extra = imgCount ? " · " + imgCount + " image" + (imgCount === 1 ? "" : "s") : "";
    setStatus("Document: Done (" + elapsed + " sec" + (elapsed === 1 ? "" : "s") + extra + ")");
  }
  function updateNavButtons() {
    btnBack.disabled = historyIndex <= 0;
    btnForward.disabled = historyIndex < 0 || historyIndex >= historyStack.length - 1;
    renderGoHistory();
  }

  /* ============================================================
   * Navigation
   * ============================================================ */
  function navigate(path, options) {
    options = options || {};
    path = normalizePath(path);
    clearLoadTimers();
    var gen = ++loadGen;
    loadStartedAt = Date.now();
    setLoading(true);

    var url = displayUrl(path);
    var host = hostFromDisplayUrl(url);
    lastAttemptedUrl = url;
    locationInput.value = url;
    windowTitle.textContent = displayTitle(path);

    if (options.fromHistory) {
      /* history already points here */
    } else if (options.replace && historyIndex >= 0) {
      historyStack[historyIndex] = path;
    } else {
      historyStack = historyStack.slice(0, historyIndex + 1);
      historyStack.push(path);
      historyIndex = historyStack.length - 1;
    }
    updateNavButtons();

    var base = options.instant ? 30 : (Number(prefs.modemDelay) || 0);
    var phases = [
      { t: 0, msg: "Contacting host: " + host + "..." },
      { t: Math.floor(base * 0.2) + 50, msg: "Host contacted. Waiting for reply..." },
      { t: Math.floor(base * 0.45) + 90, msg: "Reading file..." },
      { t: Math.floor(base * 0.7) + 120, msg: "Transferring data from " + host + "..." }
    ];
    var pi;
    for (pi = 0; pi < phases.length; pi++) {
      (function (phase) {
        statusTimers.push(window.setTimeout(function () {
          if (gen !== loadGen) return;
          setStatus(phase.msg);
        }, phase.t));
      })(phases[pi]);
    }

    var totalDelay = options.instant
      ? 50
      : base + Math.floor(Math.random() * 180) + 140;

    loadTimer = window.setTimeout(function () {
      loadTimer = null;
      if (gen !== loadGen) return;

      // Verify local file exists; period 404 if missing
      var checkPath = path.split("?")[0];
      fetch(checkPath, { method: "GET", cache: "no-store" })
        .then(function (res) {
          if (gen !== loadGen) return;
          if (!res.ok) {
            sessionStorage.setItem("itt-last-url", url);
            sessionStorage.setItem("itt-last-status", String(res.status));
            setIframeSrc("pages/error/404.html");
            return;
          }
          setStatus("Transferring data from " + host + "...");
          setIframeSrc(path);
        })
        .catch(function () {
          if (gen !== loadGen) return;
          sessionStorage.setItem("itt-last-url", url);
          setIframeSrc("pages/error/unreachable.html");
        });
    }, totalDelay);
  }

  /** Assign iframe src; force reload when path is unchanged so load events fire. */
  function setIframeSrc(path) {
    var prev = (iframe.getAttribute("src") || "").split("?")[0];
    var next = String(path).split("?")[0];
    if (prev === next) {
      ignoreIframeLoad = true;
      iframe.src = "about:blank";
      window.setTimeout(function () {
        ignoreIframeLoad = false;
        iframe.src = path;
      }, 20);
    } else {
      iframe.src = path;
    }
  }

  function goBack() {
    if (historyIndex > 0) {
      historyIndex--;
      updateNavButtons();
      navigate(historyStack[historyIndex], { fromHistory: true });
    }
  }
  function goForward() {
    if (historyIndex < historyStack.length - 1) {
      historyIndex++;
      updateNavButtons();
      navigate(historyStack[historyIndex], { fromHistory: true });
    }
  }
  function goHome() {
    navigate(prefs.homePath || HOME);
  }
  function reload() {
    navigate(currentPath(), { replace: true });
  }
  function stopLoad() {
    loadGen++;
    clearLoadTimers();
    loading = false;
    throbber.classList.add("idle");
    browserEl.classList.remove("loading");
    statusDone.textContent = "";
    setStatus("Stopped.");
    // Freeze any still-hidden images as incomplete transfer
    try {
      var doc = iframe.contentDocument;
      if (doc) {
        var imgs = doc.getElementsByTagName("img");
        for (var i = 0; i < imgs.length; i++) {
          if (imgs[i].style.visibility === "hidden") {
            applyBrokenPlaceholder(imgs[i], true);
          }
        }
      }
    } catch (e) { /* */ }
  }

  function openLocationString(val) {
    val = (val || "").trim();
    if (!val) return;
    var lower = val.toLowerCase();
    lastAttemptedUrl = val;

    // reverse map exact / prefix
    for (var k in URL_MAP) {
      if (Object.prototype.hasOwnProperty.call(URL_MAP, k)) {
        if (URL_MAP[k].toLowerCase() === lower || lower.indexOf(URL_MAP[k].toLowerCase()) === 0) {
          navigate(k);
          return;
        }
      }
    }
    if (lower.indexOf("yahoo") !== -1 || lower.indexOf("akebono") !== -1) navigate("sites/yahoo/index.html");
    else if (lower.indexOf("whitehouse") !== -1) navigate("sites/whitehouse/index.html");
    else if (lower.indexOf("nasa") !== -1) navigate("sites/nasa/index.html");
    else if (lower.indexOf("iuma") !== -1) navigate("sites/iuma/index.html");
    else if (lower.indexOf("ncsa") !== -1 || lower.indexOf("mosaic") !== -1) navigate("sites/ncsa/index.html");
    else if (lower.indexOf("jdoe") !== -1 || lower.indexOf("university.edu") !== -1) navigate("sites/personal/index.html");
    else if (lower.indexOf("skater") !== -1 || lower.indexOf("podunk") !== -1) navigate("sites/personal/messy.html");
    else if (lower.indexOf("fishcam") !== -1 || lower.indexOf("fish") !== -1) navigate("sites/fishcam/index.html");
    else if (lower.indexOf("cool.infi") !== -1 || lower.indexOf("csotd") !== -1) navigate("sites/csotd/index.html");
    else if (lower.indexOf("cern") !== -1 || lower.indexOf("info.cern") !== -1) navigate("sites/cern/index.html");
    else if (lower.indexOf("lycos") !== -1 || lower.indexOf("cmu.edu") !== -1) navigate("sites/lycos/index.html");
    else if (lower.indexOf("hotwired") !== -1 || lower.indexOf("wired") !== -1) navigate("sites/hotwired/index.html");
    else if (lower.indexOf("whats-cool") !== -1 || (lower.indexOf("cool") !== -1 && lower.indexOf("site") === -1)) navigate("pages/cool.html");
    else if (lower.indexOf("whats-new") !== -1) navigate("pages/whats-new.html");
    else if (lower.indexOf("handbook") !== -1 || lower.indexOf("manual") !== -1) navigate("pages/handbook.html");
    else if (lower.indexOf("about") !== -1 && lower.indexOf("internet") === -1) navigate("pages/about.html");
    else if (lower.indexOf("web1994") !== -1 || lower.indexOf("home.nerf") !== -1) navigate(HOME);
    else if (lower.indexOf("home.mcom.com") !== -1 || lower === "http://home.mcom.com/" || lower === "http://home.mcom.com") navigate("sites/mcom/index.html");
    else if (lower.indexOf("mcom.com") !== -1) navigate("sites/mcom/index.html");
    else if (lower.indexOf("gopher:") === 0 || lower.indexOf("ftp:") === 0) {
      showAlert("Netscape", "Netscape needs a helper application to handle this URL:\n" + val + "\n\nGopher and FTP were common in 1994 but are not mirrored in this exhibit.");
      setStatus("No helper application for this protocol.");
    } else {
      sessionStorage.setItem("itt-last-url", val);
      navigate("pages/error/unreachable.html");
      setStatus("Unable to locate the server.");
    }
  }

  /* ============================================================
   * iframe wiring
   * ============================================================ */
  function wireDocument(doc, path) {
    doc.addEventListener("mouseover", function (e) {
      var t = e.target;
      while (t && t.tagName !== "A") t = t.parentNode;
      if (t && t.tagName === "A" && t.getAttribute("href")) {
        var href = t.getAttribute("href");
        var resolved = resolveHref(href, path);
        if (resolved && resolved.external) setStatus(href);
        else if (resolved) setStatus(displayUrl(resolved.path));
        else if (href.indexOf("mailto:") === 0) setStatus(href);
        else setStatus(href);
      }
    });
    doc.addEventListener("mouseout", function (e) {
      var t = e.target;
      while (t && t.tagName !== "A") t = t.parentNode;
      if (t && t.tagName === "A") {
        if (loading) setStatus("Transferring data from host...");
        else setStatus(statusDone.textContent || "Document: Done");
      }
    });
    doc.addEventListener("click", function (e) {
      var t = e.target;
      // Click placeholder to load a single image (images-off mode)
      if (t && t.tagName === "IMG" && t.getAttribute("data-itt-pending") === "1") {
        e.preventDefault();
        e.stopPropagation();
        loadSingleImage(t);
        return;
      }
      // Imagemap regions (<area>) — used by White House etc.
      var linkEl = null;
      if (t && t.tagName === "AREA") linkEl = t;
      else {
        while (t && t.tagName !== "A") t = t.parentNode;
        if (t && t.tagName === "A") linkEl = t;
      }
      if (!linkEl) return;
      var href = linkEl.getAttribute("href");
      if (!href || href.charAt(0) === "#") return;
      if (href.indexOf("mailto:") === 0) {
        e.preventDefault();
        openMailDialog(href.replace(/^mailto:/i, ""), "From Web page");
        return;
      }
      var resolved = resolveHref(href, path);
      if (!resolved) return;
      e.preventDefault();
      e.stopPropagation();
      if (resolved.external) {
        sessionStorage.setItem("itt-last-url", href);
        navigate("pages/error/unreachable.html");
        return;
      }
      navigate(resolved.path);
    });
    doc.addEventListener("submit", function (e) {
      var form = e.target;
      if (!form || form.tagName !== "FORM") return;
      var action = form.getAttribute("action");
      if (!action) return;
      e.preventDefault();
      var resolved = resolveHref(action, path);
      if (resolved && !resolved.external) {
        var fd = new FormData(form);
        var qs = [];
        fd.forEach(function (v, k) {
          qs.push(encodeURIComponent(k) + "=" + encodeURIComponent(v));
        });
        var dest = resolved.path.split("?")[0];
        if (qs.length) dest += "?" + qs.join("&");
        navigate(dest);
      }
    });
    // underline links preference
    try {
      if (!prefs.underline) {
        var style = doc.createElement("style");
        style.textContent = "a { text-decoration: none !important; }";
        doc.head.appendChild(style);
      }
    } catch (err) { /* */ }
  }

  function applyBrokenPlaceholder(img, partial) {
    if (!img.getAttribute("data-itt-src")) {
      img.setAttribute("data-itt-src", img.getAttribute("src") || "");
    }
    img.setAttribute("data-itt-pending", "1");
    img.style.visibility = "visible";
    img.style.cursor = "pointer";
    img.style.background = "#ffffff";
    img.style.outline = "1px solid #808080";
    img.title = partial
      ? "Transfer interrupted. Click to retry."
      : ((img.getAttribute("alt") || "Image") + " — click to load");
    img.src = brokenImageUrl();
  }

  function loadSingleImage(img) {
    var src = img.getAttribute("data-itt-src");
    if (!src) return;
    setStatus("Transferring image: " + src.split("/").pop() + "...");
    throbber.classList.remove("idle");
    var delay = Math.max(120, Math.floor((Number(prefs.modemDelay) || 200) * 0.4));
    window.setTimeout(function () {
      img.removeAttribute("data-itt-pending");
      img.style.outline = "";
      img.style.cursor = "";
      img.style.background = "";
      img.src = src;
      img.title = img.getAttribute("alt") || "";
      throbber.classList.add("idle");
      setStatus("Document: Done");
    }, delay);
  }

  function applyProgressiveImages(doc) {
    var imgs = Array.prototype.slice.call(doc.getElementsByTagName("img"));
    var gen = loadGen;

    if (!imgs.length) {
      finishDocumentLoad(0);
      return;
    }

    if (!imagesOn) {
      for (var i = 0; i < imgs.length; i++) applyBrokenPlaceholder(imgs[i], false);
      finishDocumentLoad(0);
      setStatus("Document: Done (images off — click placeholders to load)");
      return;
    }

    // Progressive reveal: text is already painted; images trickle in
    var list = [];
    for (var j = 0; j < imgs.length; j++) {
      var im = imgs[j];
      if (!im.getAttribute("data-itt-src")) {
        im.setAttribute("data-itt-src", im.getAttribute("src") || "");
      }
      im.style.visibility = "hidden";
      list.push(im);
    }

    var base = Number(prefs.modemDelay) || 0;
    var perImage = Math.max(70, Math.floor(base / Math.max(2, list.length)) + 50);
    var revealed = 0;
    var totalK = Math.max(4, list.length * 12);

    function revealNext() {
      if (gen !== loadGen) return;
      if (revealed >= list.length) {
        finishDocumentLoad(list.length);
        return;
      }
      var img = list[revealed];
      img.style.visibility = "visible";
      revealed++;
      var got = Math.floor((revealed / list.length) * totalK);
      setStatus("Transferring inline images: " + got + "K of " + totalK + "K");
      imageRevealTimers.push(window.setTimeout(revealNext, perImage + Math.floor(Math.random() * 50)));
    }

    setStatus("Transferring inline images...");
    imageRevealTimers.push(window.setTimeout(revealNext, 40));
  }

  iframe.addEventListener("load", function () {
    if (ignoreIframeLoad) return;
    // Don't clear image timers that belong to a previous cancelled gen incorrectly —
    // only finish status for this load
    var path = pathFromIframe();
    if (!path || path === "about:blank" || path.indexOf("about:") === 0) return;
    // Error pages keep attempted URL in location bar when possible
    if (path.indexOf("pages/error/") === 0) {
      try {
        var attempted = sessionStorage.getItem("itt-last-url");
        if (attempted) locationInput.value = attempted;
        else locationInput.value = displayUrl(path);
      } catch (e1) {
        locationInput.value = displayUrl(path);
      }
    } else {
      locationInput.value = displayUrl(path);
    }
    windowTitle.textContent = displayTitle(path);
    try {
      var doc = iframe.contentDocument || iframe.contentWindow.document;
      // Fill error page details
      if (path.indexOf("pages/error/") === 0) {
        var urlEl = doc.getElementById("err-url");
        if (urlEl) {
          try { urlEl.textContent = sessionStorage.getItem("itt-last-url") || lastAttemptedUrl || locationInput.value; }
          catch (e2) { urlEl.textContent = lastAttemptedUrl || locationInput.value; }
        }
      }
      wireDocument(doc, path.split("?")[0]);
      applyProgressiveImages(doc);
    } catch (err) {
      finishDocumentLoad(0);
    }
  });

  /* ============================================================
   * Dialogs
   * ============================================================ */
  function openDialog(id) {
    closeMenus();
    backdrop.classList.remove("hidden");
    var el = document.getElementById(id);
    if (el) {
      el.classList.remove("hidden");
      var focusable = el.querySelector("input:not([type=checkbox]):not([type=number]), textarea, select, button");
      if (focusable) {
        window.setTimeout(function () {
          focusable.focus();
          if (focusable.select) focusable.select();
        }, 30);
      }
    }
  }
  function closeDialog(id) {
    var el = document.getElementById(id);
    if (el) el.classList.add("hidden");
    // if no other dialogs open, hide backdrop
    var open = document.querySelector(".dialog:not(.hidden)");
    if (!open) backdrop.classList.add("hidden");
  }
  function closeAllDialogs() {
    var dialogs = document.querySelectorAll(".dialog");
    for (var i = 0; i < dialogs.length; i++) dialogs[i].classList.add("hidden");
    backdrop.classList.add("hidden");
  }
  function showAlert(title, msg) {
    document.getElementById("dlg-alert-title").textContent = title || "Netscape";
    document.getElementById("dlg-alert-msg").textContent = msg;
    openDialog("dlg-alert");
  }

  document.querySelectorAll("[data-close]").forEach(function (btn) {
    btn.addEventListener("click", function () {
      closeDialog(btn.getAttribute("data-close"));
    });
  });
  backdrop.addEventListener("click", function () {
    /* classic modal: don't dismiss on outside click — Win dialogs need OK/Cancel */
  });

  /* Open Location dialog */
  document.getElementById("dlg-ol-ok").addEventListener("click", function () {
    var v = document.getElementById("dlg-ol-input").value;
    closeDialog("dlg-open-location");
    openLocationString(v);
  });
  document.getElementById("dlg-ol-input").addEventListener("keydown", function (e) {
    if (e.key === "Enter") {
      e.preventDefault();
      document.getElementById("dlg-ol-ok").click();
    }
  });

  /* Find */
  function doFind(again) {
    var q = again ? findLastQuery : document.getElementById("dlg-find-input").value;
    var matchCase = document.getElementById("dlg-find-case").checked;
    if (!q) return;
    findLastQuery = q;
    try {
      var doc = iframe.contentDocument;
      var body = doc.body;
      // clear old marks
      var marks = body.querySelectorAll("mark.itt-find");
      for (var i = 0; i < marks.length; i++) {
        var m = marks[i];
        var text = doc.createTextNode(m.textContent);
        m.parentNode.replaceChild(text, m);
      }
      body.normalize();

      var walker = doc.createTreeWalker(body, NodeFilter.SHOW_TEXT, null);
      var nodes = [];
      while (walker.nextNode()) nodes.push(walker.currentNode);
      var found = [];
      for (var n = 0; n < nodes.length; n++) {
        var node = nodes[n];
        var val = node.nodeValue;
        var hay = matchCase ? val : val.toLowerCase();
        var needle = matchCase ? q : q.toLowerCase();
        var idx = 0;
        while ((idx = hay.indexOf(needle, idx)) !== -1) {
          found.push({ node: node, index: idx, len: q.length });
          idx += needle.length;
        }
      }
      if (!found.length) {
        showAlert("Find", "Search string not found:\n\"" + q + "\"");
        findLastIndex = 0;
        return;
      }
      if (!again) findLastIndex = 0;
      else findLastIndex = (findLastIndex + 1) % found.length;
      var hit = found[findLastIndex];
      var range = doc.createRange();
      range.setStart(hit.node, hit.index);
      range.setEnd(hit.node, hit.index + hit.len);
      var mark = doc.createElement("mark");
      mark.className = "itt-find";
      mark.style.background = "#ffff00";
      mark.style.color = "#000";
      range.surroundContents(mark);
      mark.scrollIntoView({ block: "center" });
      setStatus("Found \"" + q + "\" (" + (findLastIndex + 1) + " of " + found.length + ")");
    } catch (err) {
      showAlert("Find", "Could not search this document.");
    }
  }
  document.getElementById("dlg-find-ok").addEventListener("click", function () {
    doFind(false);
  });
  document.getElementById("dlg-find-input").addEventListener("keydown", function (e) {
    if (e.key === "Enter") {
      e.preventDefault();
      doFind(false);
    }
  });

  /* Source save */
  document.getElementById("dlg-source-save").addEventListener("click", function () {
    saveDocumentSource();
  });

  /* Bookmarks dialog */
  function refreshBmDialog() {
    var sel = document.getElementById("dlg-bm-list");
    sel.innerHTML = "";
    for (var i = 0; i < bookmarks.length; i++) {
      var opt = document.createElement("option");
      opt.value = String(i);
      opt.textContent = bookmarks[i].title + "  —  " + displayUrl(bookmarks[i].path);
      sel.appendChild(opt);
    }
  }
  document.getElementById("dlg-bm-go").addEventListener("click", function () {
    var sel = document.getElementById("dlg-bm-list");
    if (sel.selectedIndex >= 0) {
      var bm = bookmarks[sel.selectedIndex];
      closeDialog("dlg-bookmarks");
      navigate(bm.path);
    }
  });
  document.getElementById("dlg-bm-list").addEventListener("dblclick", function () {
    document.getElementById("dlg-bm-go").click();
  });
  document.getElementById("dlg-bm-remove").addEventListener("click", function () {
    var sel = document.getElementById("dlg-bm-list");
    if (sel.selectedIndex >= 0) {
      bookmarks.splice(sel.selectedIndex, 1);
      saveBookmarks();
      refreshBmDialog();
    }
  });

  /* Prefs OK */
  document.getElementById("dlg-prefs-ok").addEventListener("click", function () {
    prefs.underline = document.getElementById("pref-underline").checked;
    prefs.expireDays = parseInt(document.getElementById("pref-expire").value, 10) || 30;
    prefs.autoload = document.getElementById("pref-autoload").checked;
    prefs.modemDelay = parseInt(document.getElementById("pref-modem").value, 10) || 0;
    prefs.homeUrl = document.getElementById("pref-home").value.trim() || prefs.homeUrl;
    // map home URL to path if known
    var hu = prefs.homeUrl.toLowerCase();
    prefs.homePath = HOME;
    for (var k in URL_MAP) {
      if (URL_MAP[k].toLowerCase() === hu) prefs.homePath = k;
    }
    if (hu.indexOf("yahoo") !== -1) prefs.homePath = "sites/yahoo/index.html";
    prefs.showToolbar = document.getElementById("pref-toolbar").checked;
    prefs.showLocation = document.getElementById("pref-location").checked;
    prefs.showDirbar = document.getElementById("pref-dirbar").checked;
    var deskIcons = document.getElementById("pref-desktopicons");
    if (deskIcons) prefs.showDesktopIcons = deskIcons.checked;
    var deskBg = document.getElementById("pref-desktop");
    if (deskBg) prefs.desktopBg = deskBg.value || "#000000";
    savePrefs();
    closeDialog("dlg-prefs");
    setStatus("Preferences saved.");
    reload();
  });

  /* Mail */
  function openMailDialog(to, subject) {
    document.getElementById("dlg-mail-to").value = to || "";
    document.getElementById("dlg-mail-subj").value = subject || windowTitle.textContent.replace(/ - Netscape$/, "");
    document.getElementById("dlg-mail-body").value =
      "I thought you might be interested in this URL:\n\n" + locationInput.value + "\n";
    openDialog("dlg-mail");
  }
  document.getElementById("dlg-mail-send").addEventListener("click", function () {
    var to = document.getElementById("dlg-mail-to").value.trim();
    closeDialog("dlg-mail");
    if (!to) {
      showAlert("Mail Document", "Please enter an email address.");
      return;
    }
    showAlert("Mail Document", "Message queued for delivery to:\n" + to + "\n\n(In 1994 this would launch your mail helper application.\nThis exhibit simulates a successful send.)");
    setStatus("Mail sent to " + to);
  });

  /* ============================================================
   * Menu system
   * ============================================================ */
  function closeMenus() {
    var roots = menubar.querySelectorAll(".menu-root");
    for (var i = 0; i < roots.length; i++) {
      roots[i].classList.remove("open");
      var dd = roots[i].querySelector(".menu-dropdown");
      if (dd) dd.hidden = true;
    }
  }

  function openMenu(root) {
    closeMenus();
    root.classList.add("open");
    var dd = root.querySelector(".menu-dropdown");
    if (dd) dd.hidden = false;
    if (root.getAttribute("data-menu") === "go") renderGoHistory();
    if (root.getAttribute("data-menu") === "bookmarks") renderBookmarkMenus();
  }

  var menuMode = false; // after first click, hover switches menus

  menubar.addEventListener("click", function (e) {
    var btn = e.target.closest(".menu-item");
    if (btn) {
      e.stopPropagation();
      var root = btn.parentNode;
      if (root.classList.contains("open")) {
        closeMenus();
        menuMode = false;
      } else {
        openMenu(root);
        menuMode = true;
      }
      return;
    }
    var item = e.target.closest("[data-cmd]");
    if (item && !item.disabled) {
      e.stopPropagation();
      var cmd = item.getAttribute("data-cmd");
      closeMenus();
      menuMode = false;
      runCommand(cmd, item);
    }
  });

  menubar.addEventListener("mouseover", function (e) {
    if (!menuMode) return;
    var root = e.target.closest(".menu-root");
    if (root && !root.classList.contains("open")) openMenu(root);
  });

  document.addEventListener("click", function (e) {
    if (!e.target.closest("#menubar")) {
      closeMenus();
      menuMode = false;
    }
  });

  function renderGoHistory() {
    var dd = document.getElementById("menu-go-dropdown");
    if (!dd) return;
    // remove old history items
    var old = dd.querySelectorAll("[data-hist]");
    for (var i = 0; i < old.length; i++) old[i].remove();
    // add up to 10 recent
    var start = Math.max(0, historyStack.length - 10);
    for (var h = historyStack.length - 1; h >= start; h--) {
      var path = historyStack[h];
      var b = document.createElement("button");
      b.type = "button";
      b.setAttribute("role", "menuitem");
      b.setAttribute("data-hist", "1");
      b.setAttribute("data-cmd", "go-hist");
      b.setAttribute("data-path", path);
      b.setAttribute("data-idx", String(h));
      var label = displayTitle(path).replace(/ - Netscape$/, "");
      if (h === historyIndex) label = "✓ " + label;
      else label = "   " + label;
      b.textContent = label;
      dd.appendChild(b);
    }
  }

  function renderBookmarkMenus() {
    var dd = document.getElementById("menu-bm-dropdown");
    if (!dd) return;
    var old = dd.querySelectorAll("[data-bm]");
    for (var i = 0; i < old.length; i++) old[i].remove();
    for (var b = 0; b < bookmarks.length; b++) {
      var btn = document.createElement("button");
      btn.type = "button";
      btn.setAttribute("role", "menuitem");
      btn.setAttribute("data-bm", "1");
      btn.setAttribute("data-cmd", "bm-open");
      btn.setAttribute("data-path", bookmarks[b].path);
      btn.textContent = bookmarks[b].title;
      dd.appendChild(btn);
    }
  }

  function addBookmark() {
    var path = currentPath().split("?")[0];
    var title = displayTitle(path).replace(/ - Netscape$/, "");
    for (var i = 0; i < bookmarks.length; i++) {
      if (bookmarks[i].path === path) {
        showAlert("Bookmarks", "Already bookmarked:\n" + title);
        return;
      }
    }
    bookmarks.push({ title: title, path: path });
    saveBookmarks();
    setStatus("Bookmark added: " + title);
    showAlert("Bookmarks", "Added to bookmarks:\n" + title + "\n" + displayUrl(path));
  }

  /* ============================================================
   * Commands
   * ============================================================ */
  function runCommand(cmd, el) {
    switch (cmd) {
      /* File */
      case "file-new":
        window.open(window.location.href, "_blank");
        break;
      case "file-open-file":
        document.getElementById("file-open-input").click();
        break;
      case "file-open-loc":
        document.getElementById("dlg-ol-input").value = locationInput.value;
        openDialog("dlg-open-location");
        break;
      case "file-save":
        saveDocumentSource();
        break;
      case "file-mail":
        openMailDialog("", "");
        break;
      case "file-print":
        try {
          iframe.contentWindow.focus();
          iframe.contentWindow.print();
        } catch (e) {
          window.print();
        }
        break;
      case "file-close":
      case "file-exit":
        window.location.href = "../../index.html";
        break;

      /* Edit */
      case "edit-cut":
        doClipboard("cut");
        break;
      case "edit-copy":
        doClipboard("copy");
        break;
      case "edit-paste":
        doClipboard("paste");
        break;
      case "edit-find":
        openDialog("dlg-find");
        break;
      case "edit-find-again":
        if (findLastQuery) doFind(true);
        else openDialog("dlg-find");
        break;
      case "edit-select-all":
        try {
          var doc = iframe.contentDocument;
          var sel = doc.getSelection();
          var range = doc.createRange();
          range.selectNodeContents(doc.body);
          sel.removeAllRanges();
          sel.addRange(range);
        } catch (e2) {
          locationInput.select();
        }
        break;

      /* View */
      case "view-reload":
        reload();
        break;
      case "view-images":
        imagesOn = !imagesOn;
        prefs.autoload = imagesOn;
        savePrefs();
        setStatus(imagesOn ? "Images will load." : "Images off.");
        reload();
        break;
      case "view-source":
        showSource();
        break;
      case "view-info":
        showInfo();
        break;
      case "view-stop":
      case "go-stop":
        stopLoad();
        break;

      /* Go */
      case "go-back":
        goBack();
        break;
      case "go-forward":
        goForward();
        break;
      case "go-home":
        goHome();
        break;
      case "go-hist":
        if (el) {
          var idx = parseInt(el.getAttribute("data-idx"), 10);
          if (!isNaN(idx)) {
            historyIndex = idx;
            updateNavButtons();
            navigate(historyStack[historyIndex], { fromHistory: true });
          }
        }
        break;

      /* Bookmarks */
      case "bm-add":
        addBookmark();
        break;
      case "bm-view":
        refreshBmDialog();
        openDialog("dlg-bookmarks");
        break;
      case "bm-open":
        if (el) navigate(el.getAttribute("data-path"));
        break;

      /* Options */
      case "opt-prefs":
        document.getElementById("pref-underline").checked = prefs.underline;
        document.getElementById("pref-expire").value = prefs.expireDays;
        document.getElementById("pref-autoload").checked = prefs.autoload;
        document.getElementById("pref-modem").value = String(prefs.modemDelay);
        document.getElementById("pref-home").value = prefs.homeUrl;
        document.getElementById("pref-toolbar").checked = prefs.showToolbar;
        document.getElementById("pref-location").checked = prefs.showLocation;
        document.getElementById("pref-dirbar").checked = prefs.showDirbar;
        var pdi = document.getElementById("pref-desktopicons");
        if (pdi) pdi.checked = prefs.showDesktopIcons !== false;
        var pdb = document.getElementById("pref-desktop");
        if (pdb) pdb.value = prefs.desktopBg || "#000000";
        openDialog("dlg-prefs");
        break;
      case "opt-toolbar":
        prefs.showToolbar = !prefs.showToolbar;
        savePrefs();
        break;
      case "opt-location":
        prefs.showLocation = !prefs.showLocation;
        savePrefs();
        break;
      case "opt-dirbar":
        prefs.showDirbar = !prefs.showDirbar;
        savePrefs();
        break;
      case "opt-autoload":
        prefs.autoload = !prefs.autoload;
        imagesOn = prefs.autoload;
        savePrefs();
        setStatus(imagesOn ? "Auto load images: On" : "Auto load images: Off");
        break;

      /* Directory */
      case "dir-welcome":
        navigate("sites/mcom/index.html");
        break;
      case "dir-new":
        navigate("pages/whats-new.html");
        break;
      case "dir-cool":
        navigate("pages/cool.html");
        break;
      case "dir-handbook":
        navigate("pages/handbook.html");
        break;
      case "dir-search":
        navigate("sites/lycos/index.html");
        break;
      case "dir-directory":
        navigate("sites/yahoo/index.html");
        break;
      case "dir-whitepages":
        showAlert("Internet White Pages", "Internet White Pages services (like Four11 / WhoWhere) were emerging in 1994–95.\n\nThis exhibit does not mirror an external white-pages host.\nTry Yahoo! or university directories instead.");
        break;
      case "dir-about-net":
        navigate("pages/handbook/intro.html");
        break;

      /* Help */
      case "help-about":
        openDialog("dlg-about");
        break;
      case "help-handbook":
        navigate("pages/handbook.html");
        break;
      case "help-faq":
        navigate("pages/handbook/answers.html");
        break;
      case "help-support":
        showAlert("How to Get Support", "Netscape Communications Corporation\n\nIn 1994, support was available via:\n• info@mcom.com\n• Handbook and FAQ on home.mcom.com\n• Usenet newsgroups\n\nThis reconstruction is an offline museum exhibit.");
        break;
      case "help-feedback":
        openMailDialog("info@mcom.com", "Netscape Feedback");
        break;
      case "help-exhibit":
        navigate("pages/about.html");
        break;

      default:
        setStatus("Command: " + cmd);
    }
  }

  function doClipboard(op) {
    try {
      var doc = iframe.contentDocument;
      var sel = doc.getSelection();
      if (op === "copy" || op === "cut") {
        clipboardText = sel ? sel.toString() : "";
        if (!clipboardText && locationInput === document.activeElement) {
          clipboardText = locationInput.value.substring(locationInput.selectionStart, locationInput.selectionEnd);
        }
        if (navigator.clipboard && clipboardText) {
          navigator.clipboard.writeText(clipboardText).catch(function () {});
        }
        if (op === "cut" && locationInput === document.activeElement) {
          document.execCommand("cut");
        } else if (op === "copy") {
          // try copy from iframe selection
          try { doc.execCommand("copy"); } catch (e) { /* */ }
        }
        setStatus(op === "cut" ? "Cut to clipboard." : "Copied to clipboard.");
      } else if (op === "paste") {
        if (document.activeElement === locationInput) {
          document.execCommand("paste");
        } else {
          // paste into location as fallback if focused nowhere useful
          if (clipboardText) {
            locationInput.focus();
            // modern browsers block execCommand paste; insert manually
            var start = locationInput.selectionStart;
            var end = locationInput.selectionEnd;
            var v = locationInput.value;
            locationInput.value = v.slice(0, start) + clipboardText + v.slice(end);
          }
        }
        setStatus("Pasted.");
      }
    } catch (err) {
      setStatus("Clipboard operation limited by the browser.");
    }
  }

  function showSource() {
    try {
      var doc = iframe.contentDocument;
      var html = "<!DOCTYPE html>\n" + doc.documentElement.outerHTML;
      document.getElementById("dlg-source-text").textContent = html;
      openDialog("dlg-source");
    } catch (e) {
      showAlert("Document Source", "Unable to read document source.");
    }
  }

  function saveDocumentSource() {
    try {
      var doc = iframe.contentDocument;
      var html = "<!DOCTYPE html>\n" + doc.documentElement.outerHTML;
      var blob = new Blob([html], { type: "text/html" });
      var a = document.createElement("a");
      var name = currentPath().split("?")[0].split("/").pop() || "document.html";
      if (name.indexOf(".") === -1) name += ".html";
      a.href = URL.createObjectURL(blob);
      a.download = name;
      a.click();
      URL.revokeObjectURL(a.href);
      setStatus("Saved " + name);
    } catch (e) {
      showAlert("Save As", "Could not save this document.");
    }
  }

  function showInfo() {
    var path = currentPath().split("?")[0];
    var rows = [
      ["URL", displayUrl(path)],
      ["Local path", path],
      ["Title", displayTitle(path).replace(/ - Netscape$/, "")],
      ["Protocol", "HTTP/1.0 (simulated)"],
      ["Content type", "text/html"],
      ["Source", "The Internet Through Time — 1994 reconstruction"],
      ["Images", imagesOn ? "Loaded" : "Suppressed"],
      ["Charset", "ISO-8859-1 / UTF-8"]
    ];
    try {
      var doc = iframe.contentDocument;
      rows.push(["Document size", (doc.documentElement.outerHTML.length) + " bytes (approx)"]);
      rows.push(["Links on page", String(doc.querySelectorAll("a").length)]);
      rows.push(["Images on page", String(doc.querySelectorAll("img").length)]);
    } catch (e) { /* */ }
    var table = document.getElementById("dlg-info-table");
    table.innerHTML = "";
    for (var i = 0; i < rows.length; i++) {
      var tr = document.createElement("tr");
      tr.innerHTML = "<td>" + rows[i][0] + "</td><td>" + escapeHtml(rows[i][1]) + "</td>";
      table.appendChild(tr);
    }
    openDialog("dlg-info");
  }

  function escapeHtml(s) {
    return String(s)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;");
  }

  /* Open File */
  document.getElementById("file-open-input").addEventListener("change", function (e) {
    var file = e.target.files && e.target.files[0];
    if (!file) return;
    var reader = new FileReader();
    reader.onload = function () {
      try {
        var doc = iframe.contentDocument;
        doc.open();
        doc.write(reader.result);
        doc.close();
        windowTitle.textContent = file.name + " - Netscape";
        locationInput.value = "file:///" + file.name;
        setStatus("Opened " + file.name);
        // re-wire
        wireDocument(doc, currentPath());
      } catch (err) {
        showAlert("Open File", "Could not open file:\n" + file.name);
      }
    };
    reader.readAsText(file);
    e.target.value = "";
  });

  /* ============================================================
   * Toolbar + location + dir buttons
   * ============================================================ */
  btnBack.addEventListener("click", goBack);
  btnForward.addEventListener("click", goForward);
  document.getElementById("btn-home").addEventListener("click", goHome);
  document.getElementById("btn-reload").addEventListener("click", reload);
  document.getElementById("btn-stop").addEventListener("click", stopLoad);
  document.getElementById("btn-images").addEventListener("click", function () {
    runCommand("view-images");
  });
  document.getElementById("btn-open").addEventListener("click", function () {
    runCommand("file-open-loc");
  });
  document.getElementById("btn-find").addEventListener("click", function () {
    runCommand("edit-find");
  });
  document.getElementById("btn-close").addEventListener("click", function () {
    runCommand("file-exit");
  });

  document.getElementById("btn-min").addEventListener("click", function () {
    browserEl.classList.add("minimized");
    taskIcon.classList.remove("hidden");
    setStatus("Netscape minimized.");
  });
  document.getElementById("btn-max").addEventListener("click", function () {
    maximized = !maximized;
    browserEl.classList.toggle("maximized", maximized);
    var desk = document.querySelector(".desktop");
    if (desk) desk.classList.toggle("browser-max", maximized);
  });
  taskIcon.addEventListener("click", function () {
    browserEl.classList.remove("minimized");
    taskIcon.classList.add("hidden");
  });

  locationInput.addEventListener("keydown", function (e) {
    if (e.key === "Enter") {
      e.preventDefault();
      openLocationString(locationInput.value);
    }
  });

  var dirBtns = document.querySelectorAll(".dir-btn");
  for (var d = 0; d < dirBtns.length; d++) {
    dirBtns[d].addEventListener("click", function (ev) {
      var go = ev.currentTarget.getAttribute("data-go");
      if (go) navigate(go);
    });
  }

  /* Keyboard accelerators (Netscape-ish) */
  document.addEventListener("keydown", function (e) {
    var mod = e.ctrlKey || e.metaKey;
    if (e.key === "Escape") {
      if (!backdrop.classList.contains("hidden")) {
        closeAllDialogs();
        e.preventDefault();
        return;
      }
      stopLoad();
      closeMenus();
    }
    if (!mod) return;
    var k = e.key.toLowerCase();
    if (k === "l") { e.preventDefault(); runCommand("file-open-loc"); }
    else if (k === "f") { e.preventDefault(); runCommand("edit-find"); }
    else if (k === "g") { e.preventDefault(); runCommand("edit-find-again"); }
    else if (k === "r") { e.preventDefault(); reload(); }
    else if (k === "s") { e.preventDefault(); runCommand("file-save"); }
    else if (k === "p") { e.preventDefault(); runCommand("file-print"); }
    else if (k === "d") { e.preventDefault(); runCommand("bm-add"); }
    else if (k === "left" || e.key === "ArrowLeft") { if (e.altKey) { e.preventDefault(); goBack(); } }
    else if (k === "right" || e.key === "ArrowRight") { if (e.altKey) { e.preventDefault(); goForward(); } }
  });

  /* ============================================================
   * Modem connect
   * ============================================================ */
  var overlay = document.getElementById("connect-overlay");
  var connectLog = document.getElementById("connect-log");
  var connectBtn = document.getElementById("connect-btn");
  var skipBtn = document.getElementById("skip-connect");
  function connectSequence(busyFirst) {
    var lines = [
      "Initializing modem...",
      "ATZ",
      "OK",
      "ATDT 1-800-555-NERF",
      "DIALING..."
    ];
    if (busyFirst) {
      lines.push("BUSY");
      lines.push("Retrying...");
      lines.push("ATDT 1-800-555-NERF");
      lines.push("DIALING...");
    }
    lines = lines.concat([
      "CONNECT 14400/ARQ",
      "Negotiating PPP...",
      "Authenticating user...",
      "Connected to Internet.",
      "Starting Netscape Navigator 1.0..."
    ]);
    return lines;
  }

  function seedHistory() {
    historyStack = [HOME];
    historyIndex = 0;
    updateNavButtons();
    setLoading(false);
    applyChromePrefs();
    renderBookmarkMenus();
  }
  function hideOverlay() {
    overlay.classList.add("hidden");
    try { sessionStorage.setItem("itt-1994-connected", "1"); } catch (e) { /* */ }
    seedHistory();
  }
  function runConnect() {
    connectBtn.disabled = true;
    skipBtn.disabled = true;
    connectLog.textContent = "";
    // ~25% busy signal — classic dial-up frustration
    var lines = connectSequence(Math.random() < 0.25);
    var i = 0;
    function next() {
      if (i < lines.length) {
        connectLog.textContent += lines[i] + "\n";
        var delay = 400;
        if (lines[i] === "BUSY") delay = 900;
        else if (i < 4) delay = 320;
        else delay = 480;
        i++;
        window.setTimeout(next, delay);
      } else {
        window.setTimeout(hideOverlay, 400);
      }
    }
    next();
  }
  connectBtn.addEventListener("click", runConnect);
  skipBtn.addEventListener("click", hideOverlay);

  // Desktop icon clicks — decorative period OS surface
  var deskIconsRoot = document.getElementById("desktop-icons");
  if (deskIconsRoot) {
    deskIconsRoot.addEventListener("dblclick", function (e) {
      var icon = e.target.closest(".desk-icon");
      if (!icon) return;
      var name = (icon.getAttribute("title") || "Item").replace(/\n/g, " ");
      showAlert(name, name + "\n\nThis is a decorative Windows 3.1–style desktop icon.\nOnly Netscape is functional in this exhibit.");
    });
  }

  var already = false;
  try { already = sessionStorage.getItem("itt-1994-connected") === "1"; } catch (e) { /* */ }
  if (already) {
    overlay.classList.add("hidden");
    seedHistory();
  } else {
    applyChromePrefs();
  }
})();
