/**
 * Netscape Navigator 1.0 — full chrome controller
 * The Internet Through Time · 1994 immersion
 * Menus, dialogs, bookmarks, history, prefs — all functional.
 */
(function () {
  "use strict";

  var HOME = "pages/home.html";
  var PREFS_KEY = "itt-1994-prefs";
  var BM_KEY = "itt-1994-bookmarks";

  var URL_MAP = {
    "pages/home.html": "http://home.nerf.edu/web1994/",
    "pages/about.html": "http://home.nerf.edu/web1994/about.html",
    "pages/cool.html": "http://home.mcom.com/home/whats-cool.html",
