/**
 * In-page helpers for 1994 exhibit documents (loaded inside iframe).
 * - Hit counters
 * - Persistent guestbooks
 * - Keyword search (Yahoo / Lycos)
 * - Form echo / local "mail" log
 * - Fish Cam frame cycle
 * - IUMA audio helper player
 */
(function () {
  "use strict";

  function qs(name) {
    try {
      var q = (location.search || "").replace(/^\?/, "");
      var parts = q.split("&");
      for (var i = 0; i < parts.length; i++) {
        var kv = parts[i].split("=");
        if (decodeURIComponent(kv[0] || "") === name) {
          return decodeURIComponent((kv[1] || "").replace(/\+/g, " "));
        }
      }
    } catch (e) { /* */ }
    return "";
  }

  function loadJSON(key, fallback) {
    try {
      var raw = localStorage.getItem(key);
      if (raw) return JSON.parse(raw);
    } catch (e) { /* */ }
    return fallback;
  }

  function saveJSON(key, val) {
    try {
      localStorage.setItem(key, JSON.stringify(val));
    } catch (e) { /* */ }
  }

  function escapeHtml(s) {
    return String(s)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  /* ---------- Hit counters ---------- */
  function renderCounter(el) {
    var key = "itt-hits-" + (el.getAttribute("data-counter") || "default");
    var n = parseInt(localStorage.getItem(key) || "0", 10);
    if (isNaN(n)) n = 0;
    n += 1;
    localStorage.setItem(key, String(n));
    var padded = String(n);
    while (padded.length < 6) padded = "0" + padded;
    var base = el.getAttribute("data-digit-base") || "../../assets/gif/digit-";
    el.innerHTML = "";
    for (var i = 0; i < padded.length; i++) {
      var img = document.createElement("img");
      img.src = base + padded.charAt(i) + ".gif";
      img.width = 16;
      img.height = 22;
      img.alt = padded.charAt(i);
      img.border = 0;
      el.appendChild(img);
    }
  }

  /* ---------- Guestbooks ---------- */
  function initGuestbook(root) {
    var key = root.getAttribute("data-gb-key") || "guestbook";
    var storageKey = "itt-gb-" + key;
    var listEl = root.querySelector("[data-gb-list]");
    var form = root.querySelector("form[data-gb-form]") || root.querySelector("form");
    var notice = root.querySelector("[data-gb-notice]");
    var seeds = [];
    try {
      seeds = JSON.parse(root.getAttribute("data-gb-seeds") || "[]");
    } catch (e) {
      seeds = [];
    }

    var entries = loadJSON(storageKey, null);
    if (!entries || !entries.length) {
      entries = seeds.slice();
      saveJSON(storageKey, entries);
    }

    function render() {
      if (!listEl) return;
      listEl.innerHTML = "";
      for (var i = 0; i < entries.length; i++) {
        var e = entries[i];
        var li = document.createElement("li");
        var line = "<b>" + escapeHtml(e.name || "Anonymous") + "</b>";
        if (e.from) line += " — " + escapeHtml(e.from);
        if (e.url) line += ' — <a href="' + escapeHtml(e.url) + '">' + escapeHtml(e.url) + "</a>";
        if (e.msg) line += ' — "' + escapeHtml(e.msg) + '"';
        if (e.date) line += " — " + escapeHtml(e.date);
        li.innerHTML = line;
        listEl.appendChild(li);
      }
    }

    // Accept GET submit (name fields via data-gb-fields or defaults)
    var nameF = root.getAttribute("data-gb-name") || "n";
    var fromF = root.getAttribute("data-gb-from") || "f";
    var msgF = root.getAttribute("data-gb-msg") || "c";
    var urlF = root.getAttribute("data-gb-url") || "u";

    var n = qs(nameF) || qs("name");
    var f = qs(fromF) || qs("from");
    var m = qs(msgF) || qs("m") || qs("msg") || qs("c");
    var u = qs(urlF) || qs("url");

    if (n || m) {
      var entry = {
        name: n || "Anonymous",
        from: f || "",
        msg: m || "",
        url: u || "",
        date: new Date().toLocaleDateString()
      };
      // avoid duplicate if user reloads with same query
      var sig = entry.name + "|" + entry.msg + "|" + entry.date;
      var lastSig = sessionStorage.getItem("itt-gb-last-" + key);
      if (lastSig !== sig) {
        entries.unshift(entry);
        if (entries.length > 40) entries = entries.slice(0, 40);
        saveJSON(storageKey, entries);
        sessionStorage.setItem("itt-gb-last-" + key, sig);
        if (notice) {
          notice.style.display = "block";
          notice.innerHTML = "Thanks, <b>" + escapeHtml(entry.name) + "</b> — your entry was added.";
        }
        // strip query so refresh doesn't re-add confusion
        try {
          if (window.history && history.replaceState) {
            history.replaceState(null, "", location.pathname);
          }
        } catch (err) { /* */ }
      }
    }

    render();

    // Also handle pure client submit without navigation if form has data-gb-client
    if (form && form.getAttribute("data-gb-client") === "1") {
      form.addEventListener("submit", function (ev) {
        ev.preventDefault();
        var fd = new FormData(form);
        var entry = {
          name: (fd.get(nameF) || fd.get("name") || "Anonymous") + "",
          from: (fd.get(fromF) || fd.get("from") || "") + "",
          msg: (fd.get(msgF) || fd.get("m") || fd.get("msg") || fd.get("c") || "") + "",
          url: (fd.get(urlF) || fd.get("u") || fd.get("url") || "") + "",
          date: new Date().toLocaleDateString()
        };
        if (!entry.msg && !entry.name) return;
        entries.unshift(entry);
        if (entries.length > 40) entries = entries.slice(0, 40);
        saveJSON(storageKey, entries);
        form.reset();
        if (notice) {
          notice.style.display = "block";
          notice.innerHTML = "Thanks, <b>" + escapeHtml(entry.name) + "</b> — your entry was added.";
        }
        render();
      });
    }
  }

  /* ---------- Catalog search ---------- */
  var CATALOG = [
    { title: "Yahoo! — A Guide to WWW", url: "../yahoo/index.html", abs: "sites/yahoo/index.html", keywords: "yahoo directory guide stanford jerry david categories browse", blurb: "Hierarchical guide to the World Wide Web." },
    { title: "Yahoo! — Entertainment: Music", url: "../yahoo/Entertainment/Music/index.html", abs: "sites/yahoo/Entertainment/Music/index.html", keywords: "music entertainment bands songs", blurb: "Music category in Yahoo!" },
    { title: "Yahoo! — Science: Astronomy", url: "../yahoo/Science/Astronomy/index.html", abs: "sites/yahoo/Science/Astronomy/index.html", keywords: "astronomy space stars science planets", blurb: "Astronomy links." },
    { title: "Yahoo! — Government", url: "../yahoo/Government/index.html", abs: "sites/yahoo/Government/index.html", keywords: "government politics federal agencies", blurb: "Government category." },
    { title: "Yahoo! — Computers: WWW", url: "../yahoo/Computers/WWW/index.html", abs: "sites/yahoo/Computers/WWW/index.html", keywords: "www web computers internet browsers", blurb: "World Wide Web resources." },
    { title: "IUMA — Internet Underground Music Archive", url: "../iuma/index.html", abs: "sites/iuma/index.html", keywords: "iuma music indie bands mp2 audio download underground", blurb: "Independent music on the Net." },
    { title: "NASA Home Page", url: "../nasa/index.html", abs: "sites/nasa/index.html", keywords: "nasa space shuttle astronomy aeronautics science images", blurb: "National Aeronautics and Space Administration." },
    { title: "NASA Image Gallery", url: "../nasa/images.html", abs: "sites/nasa/images.html", keywords: "nasa images photos astronomy pictures gallery", blurb: "Public domain space images." },
    { title: "Welcome to the White House", url: "../whitehouse/index.html", abs: "sites/whitehouse/index.html", keywords: "white house president clinton government whitehouse", blurb: "Interactive citizens' handbook." },
    { title: "NCSA Mosaic", url: "../ncsa/mosaic.html", abs: "sites/ncsa/mosaic.html", keywords: "mosaic browser ncsa illinois software", blurb: "The browser that popularized the Web." },
    { title: "NCSA Home", url: "../ncsa/index.html", abs: "sites/ncsa/index.html", keywords: "ncsa supercomputing illinois computing research", blurb: "National Center for Supercomputing Applications." },
    { title: "What's New With NCSA Mosaic", url: "../ncsa/whats-new.html", abs: "sites/ncsa/whats-new.html", keywords: "whats new mosaic announcements sites", blurb: "New resources on the Web." },
    { title: "World Wide Web — CERN", url: "../cern/index.html", abs: "sites/cern/index.html", keywords: "cern www web tim berners-lee hypertext origin first", blurb: "Where the Web began." },
    { title: "Welcome to Netscape", url: "../mcom/index.html", abs: "sites/mcom/index.html", keywords: "netscape mcom navigator browser handbook", blurb: "Netscape Communications home." },
    { title: "Fish Cam", url: "../fishcam/index.html", abs: "sites/fishcam/index.html", keywords: "fish cam camera webcam tank live mcom fun", blurb: "A camera pointed at a fish tank." },
    { title: "Cool Site of the Day", url: "../csotd/index.html", abs: "sites/csotd/index.html", keywords: "cool site of the day glenn davis daily", blurb: "One cool site every midnight." },
    { title: "HotWired", url: "../hotwired/index.html", abs: "sites/hotwired/index.html", keywords: "hotwired wired magazine banner ads commercial culture", blurb: "Wired magazine online." },
    { title: "Lycos Catalog of the Internet", url: "../lycos/index.html", abs: "sites/lycos/index.html", keywords: "lycos search catalog cmu crawl engine", blurb: "Early Web search / catalog." },
    { title: "John's Home Page", url: "../personal/index.html", abs: "sites/personal/index.html", keywords: "personal homepage university student resume john", blurb: "Example academic personal page." },
    { title: "SKATER's Home Page", url: "../personal/messy.html", abs: "sites/personal/messy.html", keywords: "personal homepage under construction cool links skater", blurb: "Chaotic personal homepage." },
    { title: "Netscape What's Cool!", url: "../../pages/cool.html", abs: "pages/cool.html", keywords: "cool netscape directory fun sites", blurb: "Netscape Directory — What's Cool." },
    { title: "Netscape What's New!", url: "../../pages/whats-new.html", abs: "pages/whats-new.html", keywords: "new netscape directory announcements", blurb: "Netscape Directory — What's New." },
    { title: "Netscape Handbook", url: "../../pages/handbook.html", abs: "pages/handbook.html", keywords: "handbook manual help netscape learn", blurb: "Learn Netscape Navigator." },
    { title: "Ugly Mugs (IUMA)", url: "../iuma/bands/ugly-mugs.html", abs: "sites/iuma/bands/ugly-mugs.html", keywords: "ugly mugs band indie rock music iuma", blurb: "Santa Cruz indie rock on IUMA." },
    { title: "Space Shuttle Status", url: "../nasa/shuttle.html", abs: "sites/nasa/shuttle.html", keywords: "shuttle nasa human spaceflight launch", blurb: "Space Shuttle information." }
  ];

  function scoreEntry(entry, terms) {
    var hay = (entry.title + " " + entry.keywords + " " + entry.blurb).toLowerCase();
    var score = 0;
    for (var i = 0; i < terms.length; i++) {
      var t = terms[i];
      if (!t) continue;
      if (hay.indexOf(t) !== -1) score += 2;
      if (entry.title.toLowerCase().indexOf(t) !== -1) score += 3;
    }
    return score;
  }

  function fixUrlsForContext(entry) {
    // When search page is under sites/yahoo or sites/lycos, relative ../ works for siblings
    // pages under pages/ need different base — catalog uses ../ which is correct from sites/*
    return entry;
  }

  function initSearch(root) {
    var out = root.querySelector("[data-search-results]");
    var qEl = root.querySelector("[data-search-q]");
    var form = root.querySelector("form");
    var q = qs("q") || qs("p") || qs("query") || "";
    if (qEl) qEl.value = q;
    if (form) {
      var input = form.querySelector('input[name="q"], input[name="p"], input[name="query"]');
      if (input && q) input.value = q;
    }
    if (!out) return;

    if (!q.trim()) {
      out.innerHTML = "<p>Enter a search term above. Try: <i>music</i>, <i>nasa</i>, <i>clinton</i>, <i>browser</i>, <i>fish</i>.</p>";
      return;
    }

    var terms = q.toLowerCase().split(/\s+/).filter(function (t) { return t.length > 1; });
    if (!terms.length) terms = [q.toLowerCase()];

    var hits = [];
    for (var i = 0; i < CATALOG.length; i++) {
      var e = CATALOG[i];
      var s = scoreEntry(e, terms);
      if (s > 0) hits.push({ e: e, s: s });
    }
    hits.sort(function (a, b) { return b.s - a.s; });

    var engine = root.getAttribute("data-search-engine") || "Search";
    var html = "<p><b>" + escapeHtml(engine) + "</b> results for <tt>" + escapeHtml(q) + "</tt> — " + hits.length + " match" + (hits.length === 1 ? "" : "es") + " in this exhibit's catalog.</p>";
    if (!hits.length) {
      html += "<p>No documents matched. Try a broader word, or browse <a href=\"../yahoo/index.html\">Yahoo!</a>.</p>";
      out.innerHTML = html;
      return;
    }
    html += "<ol>";
    for (var h = 0; h < hits.length; h++) {
      var item = hits[h].e;
      html += "<li><a href=\"" + escapeHtml(item.url) + "\"><b>" + escapeHtml(item.title) + "</b></a><br>" +
        "<font size=\"2\">" + escapeHtml(item.blurb) + "</font></li>";
    }
    html += "</ol>";
    out.innerHTML = html;
  }

  /* ---------- Form echo (mail, add site, submit) ---------- */
  function initFormEcho(root) {
    var map = root.getAttribute("data-echo-fields");
    if (!map) return;
    var fields = map.split(",");
    for (var i = 0; i < fields.length; i++) {
      var pair = fields[i].split(":");
      var param = pair[0];
      var sel = pair[1] || ("#echo-" + param);
      var el = root.querySelector(sel);
      if (el) {
        var val = qs(param);
        if (val) el.textContent = val;
      }
    }
    // store white house mail log
    if (root.getAttribute("data-mail-log") === "1") {
      var name = qs("name");
      var email = qs("email");
      var msg = qs("msg");
      if (name || msg) {
        var log = loadJSON("itt-wh-mail", []);
        log.unshift({ name: name, email: email, msg: msg, date: new Date().toLocaleString() });
        if (log.length > 20) log = log.slice(0, 20);
        saveJSON("itt-wh-mail", log);
      }
    }
    if (root.getAttribute("data-yahoo-add") === "1") {
      var title = qs("title");
      var url = qs("url");
      if (title || url) {
        var adds = loadJSON("itt-yahoo-adds", []);
        adds.unshift({
          title: title,
          url: url,
          cat: qs("cat"),
          desc: qs("desc"),
          email: qs("email"),
          date: new Date().toLocaleString()
        });
        if (adds.length > 30) adds = adds.slice(0, 30);
        saveJSON("itt-yahoo-adds", adds);
      }
    }
  }

  function initYahooAddList(root) {
    var list = root.querySelector("[data-yahoo-adds]");
    if (!list) return;
    var adds = loadJSON("itt-yahoo-adds", []);
    if (!adds.length) {
      list.innerHTML = "<li><i>No suggestions yet — be the first.</i></li>";
      return;
    }
    list.innerHTML = "";
    for (var i = 0; i < adds.length; i++) {
      var a = adds[i];
      var li = document.createElement("li");
      li.innerHTML = "<b>" + escapeHtml(a.title || "(untitled)") + "</b> — " +
        escapeHtml(a.url || "") +
        (a.cat ? " <font size=\"2\">[" + escapeHtml(a.cat) + "]</font>" : "") +
        (a.date ? " <font size=\"2\">— " + escapeHtml(a.date) + "</font>" : "");
      list.appendChild(li);
    }
  }

  /* ---------- Fish Cam ---------- */
  function initFishCam(root) {
    var img = root.querySelector("[data-fish-frame]");
    var label = root.querySelector("[data-fish-label]");
    if (!img) return;
    var frames = [
      { src: img.getAttribute("data-frame-0") || img.src, caption: "Tank view A — morning light" },
      { src: img.getAttribute("data-frame-1") || "", caption: "Tank view B — fish on the left" },
      { src: img.getAttribute("data-frame-2") || "", caption: "Tank view C — bubbles" },
      { src: img.getAttribute("data-frame-3") || "", caption: "Tank view D — afternoon" }
    ];
    // fill missing frame srcs from attributes or fallbacks
    var base = img.getAttribute("data-frame-base") || "";
    for (var i = 0; i < frames.length; i++) {
      var attr = img.getAttribute("data-frame-" + i);
      if (attr) frames[i].src = attr;
    }
    var n = parseInt(localStorage.getItem("itt-fishcam-n") || "0", 10) || 0;
    var frame = frames[n % frames.length];
    if (frame.src) img.src = frame.src;
    localStorage.setItem("itt-fishcam-n", String(n + 1));
    if (label) {
      label.textContent = "Frame " + ((n % frames.length) + 1) + " of " + frames.length + " · " + frame.caption +
        " · Reload for next frame · " + new Date().toLocaleTimeString();
    }
    var stamp = root.querySelector("[data-fish-time]");
    if (stamp) stamp.textContent = "Last update: " + new Date().toLocaleString() + " (simulated capture)";
  }

  /* ---------- IUMA audio player ---------- */
  function resolveAudioUrl(rel) {
    // try relative first
    return rel;
  }

  function initIumaPlayer(root) {
    var audioSrc = root.getAttribute("data-audio-src");
    if (!audioSrc) return;
    var bar = root.querySelector("[data-player-bar]");
    var st = root.querySelector("[data-player-status]");
    var btn = root.querySelector("[data-player-play]");
    var log = root.querySelector("[data-player-log]");
    var audio = new Audio(resolveAudioUrl(audioSrc));
    audio.preload = "auto";

    var playing = false;
    function setStatus(t) {
      if (st) st.textContent = t;
    }
    function setBar(pct) {
      if (!bar) return;
      pct = Math.max(0, Math.min(100, pct));
      var filled = Math.floor(pct / 10);
      var s = "[";
      for (var i = 0; i < 10; i++) s += i < filled ? "#" : "-";
      s += "] " + pct + "%";
      bar.textContent = s;
    }

    // simulated "download" then play
    var mode = root.getAttribute("data-player-mode") || "download";
    var steps = mode === "instant" ? 3 : 12;
    var step = 0;
    setStatus("Connecting to iuma.com...");
    setBar(0);
    var dl = setInterval(function () {
      step++;
      var pct = Math.floor((step / steps) * 100);
      setBar(pct);
      setStatus("Receiving audio/mpeg … " + pct + "% (14.4 kbps theater, then real audio)");
      if (log) log.textContent += ".";
      if (step >= steps) {
        clearInterval(dl);
        setStatus("Download complete. Ready to play.");
        setBar(100);
        if (btn) btn.disabled = false;
        if (root.getAttribute("data-autoplay") === "1") {
          tryPlay();
        }
      }
    }, mode === "instant" ? 120 : 350);

    function tryPlay() {
      setStatus("Launching helper application… Playing track.mp2");
      audio.currentTime = 0;
      var p = audio.play();
      if (p && p.catch) {
        p.catch(function () {
          setStatus("Click Play — browser blocked autoplay (period players needed a click too).");
        });
      }
      playing = true;
      if (btn) btn.textContent = "Stop";
    }

    if (btn) {
      btn.disabled = true;
      btn.addEventListener("click", function () {
        if (playing && !audio.paused) {
          audio.pause();
          playing = false;
          btn.textContent = "Play";
          setStatus("Stopped.");
        } else {
          tryPlay();
        }
      });
    }

    audio.addEventListener("timeupdate", function () {
      if (!audio.duration) return;
      var pct = Math.floor((audio.currentTime / audio.duration) * 100);
      setBar(pct);
      setStatus("Playing… " + Math.floor(audio.currentTime) + "s / " + Math.floor(audio.duration) + "s");
    });
    audio.addEventListener("ended", function () {
      playing = false;
      if (btn) btn.textContent = "Play again";
      setStatus("Finished. (Demo track — short sample in this exhibit.)");
      setBar(100);
    });
  }

  /* ---------- Boot ---------- */
  document.addEventListener("DOMContentLoaded", function () {
    var counters = document.querySelectorAll(".hit-counter");
    for (var i = 0; i < counters.length; i++) renderCounter(counters[i]);

    var gbs = document.querySelectorAll("[data-guestbook]");
    for (var g = 0; g < gbs.length; g++) initGuestbook(gbs[g]);

    var searches = document.querySelectorAll("[data-search]");
    for (var s = 0; s < searches.length; s++) initSearch(searches[s]);

    var echos = document.querySelectorAll("[data-echo-fields]");
    for (var e = 0; e < echos.length; e++) initFormEcho(echos[e]);

    var adds = document.querySelectorAll("[data-yahoo-adds]");
    for (var a = 0; a < adds.length; a++) initYahooAddList(adds[a].closest("body") || document.body);
    // also if body has data-yahoo-adds list only
    initYahooAddList(document.body);

    var fish = document.querySelectorAll("[data-fishcam]");
    for (var f = 0; f < fish.length; f++) initFishCam(fish[f]);

    var players = document.querySelectorAll("[data-iuma-player]");
    for (var p = 0; p < players.length; p++) initIumaPlayer(players[p]);
  });
})();
