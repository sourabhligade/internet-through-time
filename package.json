{
  "name": "internet-through-time",
  "private": true,
  "description": "Museum static site — historical web reconstruction year by year (no build for deploy)",
  "license": "MIT",
  "scripts": {
    "serve": "python3 -m http.server 8080 --bind 127.0.0.1",
    "smoke": "python3 scripts/smoke-production.py",
    "smoke:http": "python3 scripts/smoke-production.py --base http://127.0.0.1:8080",
    "audit:links": "python3 scripts/audit-internal-links.py",
    "test:static": "python3 scripts/test-authenticity.py && python3 scripts/test-pipeline.py",
    "test:e2e": "playwright test",
    "test:e2e:cross-year": "playwright test e2e/cross-year-real-flows.spec.js --workers=1",
    "test:e2e:scenarios": "playwright test e2e/scenario-real-flows.spec.js --workers=1",
    "test:e2e:real-gates": "playwright test e2e/cross-year-real-flows.spec.js e2e/scenario-real-flows.spec.js --workers=1",
    "check": "python3 scripts/smoke-production.py && python3 scripts/audit-internal-links.py && python3 scripts/test-authenticity.py && python3 scripts/test-pipeline.py",
    "check:years": "python3 scripts/check-all-years.py",
    "check:years:http": "python3 scripts/check-all-years.py --http http://127.0.0.1:8080",
    "test:e2e:years": "playwright test e2e/all-years-smoke.spec.js --workers=1",
    "test:e2e:2008": "playwright test e2e/2008-mvp.spec.js e2e/2008-real-flows.spec.js e2e/2008-densify.spec.js e2e/2008-flows.spec.js e2e/2008-trail-real-flows.spec.js --workers=1",
    "test:years": "python3 scripts/check-all-years.py && playwright test e2e/all-years-smoke.spec.js --workers=1",
    "test": "npm run check && playwright test",
    "ci": "bash scripts/ci.sh",
    "perf": "python3 scripts/measure-perf.py",
    "github:ready": "bash scripts/github-ready.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "1.49.0"
  }
}
